{
  "data-root": "/srv/devserver/docker",
  "exec-root": "/run/docker-devserver",
  "pidfile": "/run/docker-devserver.pid",
  "hosts": ["unix:///run/docker-devserver.sock"],
  "bridge": "br-ds-default",
  "iptables": false,
  "ip6tables": false,
  "ip-forward": false,
  "ip-masq": false,
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "64m",
    "max-file": "2"
  },
  "builder": {
    "gc": {
      "enabled": true,
      "defaultKeepStorage": "8GB"
    }
  }
}
