[Unit]
Description=DevServer health and resource maintenance
After=docker-devserver.service devserver-network.service network-online.target
Requires=docker-devserver.service devserver-network.service
RequiresMountsFor=/srv/devserver
ConditionPathIsMountPoint=/srv/devserver

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/devserver-maintenance
ExecStart=/usr/local/libexec/devserver-maintenance.sh
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUWeight=10
IOWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ReadWritePaths=/srv/devserver /run/lock
