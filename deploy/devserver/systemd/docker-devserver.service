[Unit]
Description=DevServer isolated Docker engine
Documentation=https://docs.docker.com
After=network-online.target docker.service containerd-devserver.service
Wants=network-online.target docker.service
Requires=containerd-devserver.service
RequiresMountsFor=/srv/devserver
ConditionPathIsMountPoint=/srv/devserver

[Service]
Type=notify
ExecStartPre=/usr/local/libexec/devserver-network.sh system-bridge-check
ExecStartPre=/usr/local/libexec/devserver-network.sh daemon-bridge-up
ExecStart=/usr/bin/dockerd --config-file=/etc/devserver-runtime/daemon.json --containerd=/run/containerd-devserver/containerd.sock --group=docker
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutSec=0
Restart=always
RestartSec=2
StartLimitBurst=3
StartLimitInterval=60s
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
KillMode=process

[Install]
WantedBy=multi-user.target
